<div class="diagram">
<svg class="flowgraph" viewBox="0 0 268.6 66.0" width="268.6" height="66.0" style="max-width:100%;height:auto">
<defs><marker id="gs1s1-arrow" viewBox="0 0 8 6" refX="8" refY="3" markerWidth="8" markerHeight="6" markerUnits="userSpaceOnUse" orient="auto"><path class="arrow" d="M 0 0 L 8 3 L 0 6 z"/></marker></defs>
<path class="edge" marker-end="url(#gs1s1-arrow)" d="M 98.6 33.0 C 135.6 33.0, 135.6 33.0, 172.6 33.0"/>
<text class="port" x="103.6" y="28.0">out</text>
<text class="port" x="167.6" y="28.0" text-anchor="end">0.0</text>
<rect class="node" x="12.0" y="12.0" width="86.6" height="42.0" rx="7" ry="7"/>
<text class="name" x="55.3" y="38.0" text-anchor="middle">fine_gain</text>
<rect class="node" x="172.6" y="12.0" width="84.0" height="42.0" rx="7" ry="7"/>
<text class="name" x="214.6" y="38.0" text-anchor="middle">combiner</text>
</svg>
</div>
<h4>Blocks</h4>
<div class="table bounded">
<table>
<thead>
<tr><th>Name</th><th>Type</th><th>Parameters</th><th>Meta information</th></tr>
</thead>
