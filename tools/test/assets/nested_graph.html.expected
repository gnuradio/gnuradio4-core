<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nested graph fixture</title>
<style>
:root { color-scheme: light dark; --fg: #1a1a1a; --bg: #ffffff; --muted: #5a6270; --rule: #d5d9e0; --panel: #f5f6f8; --accent: #1f5fa9; }
@media (prefers-color-scheme: dark) {
  :root { --fg: #e6e6e6; --bg: #14171c; --muted: #9aa4b2; --rule: #2c313a; --panel: #1c2027; --accent: #7fb2f0; }
}
* { box-sizing: border-box; }
body { margin: 0 auto; padding: 2rem 1.25rem 4rem; max-width: 60rem; background: var(--bg); color: var(--fg);
       font: 15px/1.6 -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
h1, h2, h3, h4, h5, h6 { line-height: 1.25; margin: 2rem 0 0.75rem; }
h1 { font-size: 1.9rem; margin-top: 0; padding-bottom: 0.4rem; border-bottom: 2px solid var(--rule); }
h2 { font-size: 1.4rem; padding-bottom: 0.3rem; border-bottom: 1px solid var(--rule); }
h3 { font-size: 1.15rem; }
h4, h5, h6 { font-size: 1rem; color: var(--muted); }
p, ul { margin: 0.6rem 0; }
ul { padding-left: 1.4rem; }
a { color: var(--accent); }
code, pre { font-family: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace; font-size: 0.87em; }
code { background: var(--panel); padding: 0.1em 0.35em; border-radius: 3px; }
pre { background: var(--panel); border: 1px solid var(--rule); border-radius: 5px; padding: 0.9rem 1rem; overflow-x: auto; }
pre code { background: none; padding: 0; }
div.table { overflow-x: auto; }
div.table.bounded { max-height: 60vh; overflow: auto; margin: 0.8rem 0; }
div.table.bounded table { margin: 0; }
/* a collapsed border does not travel with a sticky cell, so the header keeps its rule as a shadow */
div.table.bounded thead th { position: sticky; top: 0; z-index: 1; box-shadow: inset 0 -1px var(--rule); }
table { border-collapse: collapse; width: 100%; margin: 0.8rem 0; }
th, td { border: 1px solid var(--rule); padding: 0.35rem 0.6rem; text-align: left; vertical-align: top; }
th { background: var(--panel); font-weight: 600; }
tbody tr:nth-child(even) { background: color-mix(in srgb, var(--panel) 45%, transparent); }
div.diagram { overflow-x: auto; }
svg.flowgraph { display: block; margin: 0.9rem 0; }
svg.flowgraph .node { fill: var(--panel); stroke: var(--muted); stroke-width: 1.2; }
svg.flowgraph .node.unresolved { stroke-dasharray: 5 4; }
svg.flowgraph .inner { fill: none; stroke: var(--muted); stroke-width: 1; }
svg.flowgraph .name { fill: var(--fg); font: 600 13px -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
svg.flowgraph .type { fill: var(--muted); font: 11px ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace; }
svg.flowgraph .port { fill: var(--muted); font: 10px ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace; }
svg.flowgraph .edge { fill: none; stroke: var(--accent); stroke-width: 1.3; }
svg.flowgraph .arrow { fill: var(--accent); }
</style>
</head>
<body>
<h1>Nested graph fixture</h1>
<h2>Summary</h2>
<ul>
<li><strong>Blocks at the top level</strong>: 3</li>
<li><strong>Connections at the top level</strong>: 2</li>
<li><strong>Subgraphs, all depths</strong>: 2</li>
<li><strong>Schedulers</strong>: gr::scheduler::Simple</li>
</ul>
<h2>Definition metadata</h2>
<div class="table">
<table>
<thead>
<tr><th>Key</th><th>Value</th></tr>
</thead>
<tbody>
<tr><td>block_type</td><td>&quot;qa::doc_fixture&quot;</td></tr>
<tr><td>plugin_author</td><td>&quot;GNU Radio&quot;</td></tr>
<tr><td>plugin_license</td><td>&quot;MIT&quot;</td></tr>
<tr><td>plugin_name</td><td>&quot;Doc Tools Fixture&quot;</td></tr>
<tr><td>plugin_version</td><td>&quot;1&quot;</td></tr>
</tbody>
</table>
</div>
<h2>Diagram</h2>
<div class="diagram">
<svg class="flowgraph" viewBox="0 0 426.6 66.0" width="426.6" height="66.0" style="max-width:100%;height:auto">
<defs><marker id="g-arrow" viewBox="0 0 8 6" refX="8" refY="3" markerWidth="8" markerHeight="6" markerUnits="userSpaceOnUse" orient="auto"><path class="arrow" d="M 0 0 L 8 3 L 0 6 z"/></marker></defs>
<path class="edge" marker-end="url(#g-arrow)" d="M 96.0 33.0 C 133.0 33.0, 133.0 33.0, 170.0 33.0"/>
<text class="port" x="101.0" y="28.0">0</text>
<text class="port" x="165.0" y="28.0" text-anchor="end">0</text>
<path class="edge" marker-end="url(#g-arrow)" d="M 256.6 33.0 C 293.6 33.0, 293.6 33.0, 330.6 33.0"/>
<text class="port" x="261.6" y="28.0">0</text>
<text class="port" x="325.6" y="28.0" text-anchor="end">0</text>
<rect class="node" x="12.0" y="12.0" width="84.0" height="42.0" rx="7" ry="7"/>
<text class="name" x="54.0" y="38.0" text-anchor="middle">source</text>
<rect class="node" x="170.0" y="12.0" width="86.6" height="42.0" rx="7" ry="7"/>
<rect class="inner" x="173.0" y="15.0" width="80.6" height="36.0" rx="5" ry="5"/>
<text class="name" x="213.3" y="38.0" text-anchor="middle">front_end</text>
<rect class="node" x="330.6" y="12.0" width="84.0" height="42.0" rx="7" ry="7"/>
<text class="name" x="372.6" y="38.0" text-anchor="middle">sink</text>
</svg>
</div>
<h2>Blocks</h2>
<div class="table bounded">
<table>
<thead>
<tr><th>Name</th><th>Type</th><th>Parameters</th><th>Meta information</th></tr>
</thead>
<tbody>
<tr><td>source<br>(source_1)</td><td>qa::RampSource</td><td>n_samples: 4096<br>name: &quot;source&quot;</td><td></td></tr>
<tr><td>front_end</td><td>SUBGRAPH<br>(subgraph)</td><td></td><td></td></tr>
<tr><td>sink</td><td>qa::RecordingSink</td><td>name: &quot;sink&quot;<br>[context fast @ 0] buffer_size: 512</td><td>role: &quot;terminal&quot;</td></tr>
</tbody>
</table>
</div>
<h2>Connections</h2>
<div class="table">
<table>
<thead>
<tr><th>From</th><th>Port</th><th>To</th><th>Port</th><th>Type</th><th>Minimum buffer</th></tr>
</thead>
<tbody>
<tr><td>source_1</td><td>0</td><td>front_end</td><td>0</td><td></td><td></td></tr>
<tr><td>front_end</td><td>0</td><td>sink</td><td>0</td><td></td><td>4096</td></tr>
</tbody>
</table>
</div>
<h2>Other keys</h2>
<div class="table">
<table>
<thead>
<tr><th>Key</th><th>Value</th></tr>
</thead>
<tbody>
<tr><td>graph_version</td><td>1</td></tr>
</tbody>
</table>
</div>
<h2>Other block keys</h2>
<div class="table">
<table>
<thead>
<tr><th>Block</th><th>Key</th><th>Value</th></tr>
</thead>
<tbody>
<tr><td>sink</td><td>layout_hint</td><td>&quot;bottom-right&quot;</td></tr>
</tbody>
</table>
</div>
<h2 id="subgraph-front-end">Subgraph: front_end</h2>
<ul>
<li><strong>Type</strong>: SUBGRAPH</li>
<li><strong>Scheduler</strong>: none, the parent schedules its blocks</li>
<li><strong>Blocks</strong>: 2</li>
<li><strong>Connections</strong>: 1</li>
</ul>
<h3>Exported ports</h3>
<div class="table">
<table>
<thead>
<tr><th>Exported as</th><th>Direction</th><th>Inner block</th><th>Inner port</th></tr>
</thead>
<tbody>
<tr><td>in</td><td>INPUT</td><td>pre_gain</td><td>in</td></tr>
<tr><td>out</td><td>OUTPUT</td><td>inner_chain</td><td>out</td></tr>
</tbody>
</table>
</div>
<h3>Diagram</h3>
<div class="diagram">
<svg class="flowgraph" viewBox="0 0 283.4 66.0" width="283.4" height="66.0" style="max-width:100%;height:auto">
<defs><marker id="gs1-arrow" viewBox="0 0 8 6" refX="8" refY="3" markerWidth="8" markerHeight="6" markerUnits="userSpaceOnUse" orient="auto"><path class="arrow" d="M 0 0 L 8 3 L 0 6 z"/></marker></defs>
<path class="edge" marker-end="url(#gs1-arrow)" d="M 96.0 33.0 C 133.0 33.0, 133.0 33.0, 170.0 33.0"/>
<text class="port" x="101.0" y="28.0">out</text>
<text class="port" x="165.0" y="28.0" text-anchor="end">in</text>
<rect class="node" x="12.0" y="12.0" width="84.0" height="42.0" rx="7" ry="7"/>
<text class="name" x="54.0" y="38.0" text-anchor="middle">pre_gain</text>
<rect class="node" x="170.0" y="12.0" width="101.4" height="42.0" rx="7" ry="7"/>
<rect class="inner" x="173.0" y="15.0" width="95.4" height="36.0" rx="5" ry="5"/>
<text class="name" x="220.7" y="38.0" text-anchor="middle">inner_chain</text>
</svg>
</div>
<h3>Blocks</h3>
<div class="table bounded">
<table>
<thead>
<tr><th>Name</th><th>Type</th><th>Parameters</th><th>Meta information</th></tr>
</thead>
<tbody>
<tr><td>pre_gain</td><td>qa::Scale</td><td>enabled: true<br>gain: 2.000000<br>label: &quot;front&quot;<br>name: &quot;pre_gain&quot;</td><td></td></tr>
<tr><td>inner_chain</td><td>SUBGRAPH<br>(subgraph, scheduler gr::scheduler::Simple)</td><td>name: &quot;inner_chain&quot;</td><td></td></tr>
</tbody>
</table>
</div>
<h3>Connections</h3>
<div class="table">
<table>
<thead>
<tr><th>From</th><th>Port</th><th>To</th><th>Port</th><th>Type</th><th>Minimum buffer</th></tr>
</thead>
<tbody>
<tr><td>pre_gain</td><td>out</td><td>inner_chain</td><td>in</td><td></td><td></td></tr>
</tbody>
</table>
</div>
<h3 id="subgraph-front-end-inner-chain">Subgraph: front_end / inner_chain</h3>
<ul>
<li><strong>Type</strong>: SUBGRAPH</li>
<li><strong>Scheduler</strong>: gr::scheduler::Simple</li>
<li><strong>Blocks</strong>: 2</li>
<li><strong>Connections</strong>: 1</li>
</ul>
<h4>Exported ports</h4>
<div class="table">
<table>
<thead>
<tr><th>Exported as</th><th>Direction</th><th>Inner block</th><th>Inner port</th></tr>
</thead>
<tbody>
<tr><td>in</td><td>INPUT</td><td>fine_gain</td><td>in</td></tr>
<tr><td>out</td><td>OUTPUT</td><td>combiner</td><td>out</td></tr>
</tbody>
</table>
</div>
