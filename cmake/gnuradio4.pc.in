# cmake/gnuradio4.pc.in

prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: GNU Radio 4
Description: Next-generation GNU Radio framework
Version: @GR4_PKG_VERSION@

Cflags: -I${includedir}@GR4_PKGCONFIG_CACHE_LINE_CFLAG@
Libs: -L${libdir} -lgnuradio-core -lgnuradio-shared-state -lgnuradio-blocklib-core@GR4_PKGCONFIG_PLUGIN_LIB@ @GR4_PKGCONFIG_EXTRA_LIBS@
