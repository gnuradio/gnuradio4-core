# define global block building command

# balanced chunking of generated registration TUs: bounds per-TU compile time and memory
# (large cartesian expansions are split, small macro lines are packed together).
# 0 emits one TU per GR_REGISTER_BLOCK line.
set(GR_BLOCKLIB_MAX_REGISTRATIONS_PER_TU
    "16"
    CACHE STRING "Maximum registerBlock instantiations per generated translation unit (0 = one TU per macro line)")

# precompile the registry + block headers for the generated registration TUs (build-tree only,
# invisible to consumers). Roughly -20% per TU with GCC, -65% with Clang (-fpch-instantiate-templates).
option(GR_BLOCKLIB_PCH "Use precompiled headers for generated block-registration translation units" ON)

# which of the two generators writes the registration units. They produce the same files with the
# same contents; the Python one is faster to run, the CMake one needs nothing but CMake. AUTO takes
# Python when an interpreter is found and the CMake script otherwise.
set(GR_BLOCKLIB_GENERATOR
    "AUTO"
    CACHE STRING "Block-registration generator: AUTO, PYTHON or CMAKE")
set_property(CACHE GR_BLOCKLIB_GENERATOR PROPERTY STRINGS AUTO PYTHON CMAKE)

# Both generators sit beside these macros in an installed package; in this project's own build tree
# the configured macros are in the binary directory, so fall back to the source they came from.
# These are read by gr_generate_block_instantiations(), which a consumer calls from any directory it
# likes, so they are cache entries rather than variables of the scope that included these macros.
set(GR_BLOCKLIB_CMAKE_GENERATOR_PATH "${CMAKE_CURRENT_LIST_DIR}/GrParseRegistrations.cmake")
if(NOT EXISTS "${GR_BLOCKLIB_CMAKE_GENERATOR_PATH}")
    set(GR_BLOCKLIB_CMAKE_GENERATOR_PATH @CMAKE_CURRENT_SOURCE_DIR@/GrParseRegistrations.cmake)
endif()
set(GR_BLOCKLIB_CMAKE_GENERATOR
    "${GR_BLOCKLIB_CMAKE_GENERATOR_PATH}"
    CACHE INTERNAL "the CMake block-registration generator")
set(GR_BLOCKLIB_PYTHON_GENERATOR_PATH "${CMAKE_CURRENT_LIST_DIR}/parse_registrations.py")
if(NOT EXISTS "${GR_BLOCKLIB_PYTHON_GENERATOR_PATH}")
    set(GR_BLOCKLIB_PYTHON_GENERATOR_PATH @CMAKE_CURRENT_SOURCE_DIR@/parse_registrations.py)
endif()
set(GR_BLOCKLIB_PYTHON_GENERATOR
    "${GR_BLOCKLIB_PYTHON_GENERATOR_PATH}"
    CACHE INTERNAL "the Python block-registration generator")

# The generator uses the standard library alone, so an interpreter is the whole dependency. A project
# that already looked for Python keeps its result; nothing here is REQUIRED, and nothing is looked up
# when the CMake generator is the one asked for.
if(NOT GR_BLOCKLIB_GENERATOR STREQUAL "CMAKE" AND NOT Python3_Interpreter_FOUND)
    find_package(Python3 QUIET COMPONENTS Interpreter)
endif()

if(GR_BLOCKLIB_GENERATOR STREQUAL "PYTHON")
    if(NOT Python3_Interpreter_FOUND)
        message(FATAL_ERROR "GR_BLOCKLIB_GENERATOR=PYTHON, but no Python 3 interpreter was found")
    endif()
    set(GR_BLOCKLIB_GENERATOR_CHOICE PYTHON)
elseif(GR_BLOCKLIB_GENERATOR STREQUAL "CMAKE")
    set(GR_BLOCKLIB_GENERATOR_CHOICE CMAKE)
elseif(GR_BLOCKLIB_GENERATOR STREQUAL "AUTO")
    if(Python3_Interpreter_FOUND)
        set(GR_BLOCKLIB_GENERATOR_CHOICE PYTHON)
    else()
        set(GR_BLOCKLIB_GENERATOR_CHOICE CMAKE)
    endif()
else()
    message(FATAL_ERROR "GR_BLOCKLIB_GENERATOR is '${GR_BLOCKLIB_GENERATOR}', not AUTO, PYTHON or CMAKE")
endif()
set(GR_BLOCKLIB_GENERATOR_USED
    "${GR_BLOCKLIB_GENERATOR_CHOICE}"
    CACHE INTERNAL "the block-registration generator this build tree uses")

if(GR_BLOCKLIB_GENERATOR_USED STREQUAL "PYTHON")
    message(STATUS "[BlockLibMacros] block-registration generator: ${GR_BLOCKLIB_PYTHON_GENERATOR} (${Python3_EXECUTABLE})")
else()
    message(STATUS "[BlockLibMacros] block-registration generator: ${GR_BLOCKLIB_CMAKE_GENERATOR}")
endif()

function(gr_detail_append_file_to MERGE_OUTPUT_FILE MERGE_INPUT_FILE)
  file(READ ${MERGE_INPUT_FILE} CONTENTS)
  file(APPEND ${MERGE_OUTPUT_FILE} "${CONTENTS}")
endfunction()

function(gr_detail_merge_files_into MERGE_OUTPUT_FILE MERGE_INPUT_FILES)
  file(WRITE ${MERGE_OUTPUT_FILE} "")
  foreach(MERGE_INPUT_FILE ${MERGE_INPUT_FILES})
    gr_detail_append_file_to(${MERGE_OUTPUT_FILE} ${MERGE_INPUT_FILE})
  endforeach()
endfunction()

function(gr_generate_block_instantiations LIB_NAME)
    if(DEFINED GR_ENABLE_BLOCK_REGISTRY AND NOT ${GR_ENABLE_BLOCK_REGISTRY})
        message(WARNING "GR_ENABLE_BLOCK_REGISTRY is set to Off, not generating block instantiations for ${LIB_NAME}")
        return()
    endif()

    set(options "SPLIT_BLOCK_INSTANTIATIONS")
    set(oneValueArgs REGISTRY_HEADER REGISTRY_INSTANCE MODULE_NAME_BASE MAX_REGISTRATIONS_PER_TU)
    set(multiValueArgs HEADERS SOURCES)
    cmake_parse_arguments(CBL "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if (NOT CBL_MODULE_NAME_BASE)
        set (MODULE_NAME_BASE ${LIB_NAME})
    else()
        set (MODULE_NAME_BASE ${CBL_MODULE_NAME_BASE})
    endif()

    if (NOT TARGET ${LIB_NAME})
        message(FATAL_ERROR "${LIB_NAME} is not a target")
    endif()

    if (NOT CBL_HEADERS)
        message(FATAL_ERROR "No headers passed to gr_generate_block_instantiations")
    endif()

    if(GR_SPLIT_BLOCK_INSTANTIATIONS OR CBL_SPLIT_BLOCK_INSTANTIATIONS)
        set(PARSER_SPLIT ON)
        set(PARSER_SPLIT_ARG "-DSPLIT=ON")
        set(PARSER_SPLIT_PY_ARG "--split")
    else()
        set(PARSER_SPLIT OFF)
        set(PARSER_SPLIT_ARG "")
        set(PARSER_SPLIT_PY_ARG "")
    endif()

    # SPLIT and MAX_PER_TU are mutually exclusive; an explicit split request wins
    if(PARSER_SPLIT)
        set(EFFECTIVE_MAX_PER_TU 0)
    elseif(DEFINED CBL_MAX_REGISTRATIONS_PER_TU AND NOT CBL_MAX_REGISTRATIONS_PER_TU STREQUAL "")
        set(EFFECTIVE_MAX_PER_TU ${CBL_MAX_REGISTRATIONS_PER_TU})
    else()
        set(EFFECTIVE_MAX_PER_TU ${GR_BLOCKLIB_MAX_REGISTRATIONS_PER_TU})
    endif()
    if(EFFECTIVE_MAX_PER_TU GREATER 0)
        set(PARSER_MAX_PER_TU_ARG "-DMAX_PER_TU=${EFFECTIVE_MAX_PER_TU}")
        set(PARSER_MAX_PER_TU_PY_ARG "--max-per-tu" "${EFFECTIVE_MAX_PER_TU}")
    else()
        set(PARSER_MAX_PER_TU_ARG "")
        set(PARSER_MAX_PER_TU_PY_ARG "")
    endif()

    if(CBL_REGISTRY_HEADER)
        set(PARSER_REGISTRY_HEADER_ARG "-DREGISTRY_HEADER=${CBL_REGISTRY_HEADER}")
        set(PARSER_REGISTRY_HEADER_PY_ARG "--registry-header" "${CBL_REGISTRY_HEADER}")
    else()
        set(PARSER_REGISTRY_HEADER_ARG "")
        set(PARSER_REGISTRY_HEADER_PY_ARG "")
    endif()

    if(CBL_REGISTRY_INSTANCE)
        set(PARSER_REGISTRY_INSTANCE_ARG "-DREGISTRY_INSTANCE=${CBL_REGISTRY_INSTANCE}")
        set(PARSER_REGISTRY_INSTANCE_PY_ARG "--registry-instance" "${CBL_REGISTRY_INSTANCE}")
    else()
        set(PARSER_REGISTRY_INSTANCE_ARG "")
        set(PARSER_REGISTRY_INSTANCE_PY_ARG "")
    endif()

    # directory where the generator script will output .cpp files.
    set(GEN_DIR "${CMAKE_BINARY_DIR}/plugins/${MODULE_NAME_BASE}")
    file(MAKE_DIRECTORY "${GEN_DIR}")
    target_include_directories(${LIB_NAME} PUBLIC ${GEN_DIR})
    target_include_directories(${LIB_NAME} PUBLIC ${CMAKE_BINARY_DIR}/include)

    set(GEN_CPP_LIST "${GEN_DIR}/integrator.cpp")

    # generation options are part of the staleness check: changing them must regenerate
    set(GEN_OPTIONS_SIG "${PARSER_SPLIT}|${EFFECTIVE_MAX_PER_TU}|${CBL_REGISTRY_HEADER}|${CBL_REGISTRY_INSTANCE}")

    foreach(HDR IN LISTS CBL_HEADERS)
        # Try to only run the generation when the header is newer than the last time
        set(modified 0)
        file(TIMESTAMP ${HDR} modified "%s")
        if (NOT DEFINED modified_${HDR} OR "${modified}" GREATER modified_${HDR} OR NOT "${genopts_${HDR}}" STREQUAL "${GEN_OPTIONS_SIG}")
            set(modified_${HDR} ${modified} CACHE STRING "Last generated time" FORCE)
            set(genopts_${HDR} "${GEN_OPTIONS_SIG}" CACHE STRING "Last generation options" FORCE)

            get_filename_component(ABS_HDR "${HDR}" ABSOLUTE)
            get_filename_component(BASENAME "${HDR}" NAME_WE)

            # remove any previously generated .cpp files for this header
            # (anchored globs so e.g. 'Math' does not also delete 'MathExtra' outputs).
            file(GLOB OLD_FILES "${GEN_DIR}/${BASENAME}_*.cpp" "${GEN_DIR}/dummy_${BASENAME}.cpp")
            if(OLD_FILES)
                message(STATUS "[BlockLibMacros] deleting old generated files ${OLD_FILES}")
                file(REMOVE ${OLD_FILES})
            endif()

            file(GLOB OLD_FILES "${GEN_DIR}/${BASENAME}_*.hpp.in")
            if(OLD_FILES)
                message(STATUS "[BlockLibMacros] deleting old generated files ${OLD_FILES}")
                file(REMOVE ${OLD_FILES})
            endif()

            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${HDR})

            message(STATUS "[BlockLibMacros] Generating code for header: ${ABS_HDR} -> ${GEN_DIR} with SPLIT=${PARSER_SPLIT}, other options [ ${PARSER_MAX_PER_TU_ARG} ${PARSER_REGISTRY_HEADER_ARG} ${PARSER_REGISTRY_INSTANCE_ARG} ]")

            # the two generators take the same options under their own spellings
            if(GR_BLOCKLIB_GENERATOR_USED STREQUAL "PYTHON")
                set(PARSER_COMMAND
                    ${Python3_EXECUTABLE} "${GR_BLOCKLIB_PYTHON_GENERATOR}"
                    "--header" "${ABS_HDR}" "--out-dir" "${GEN_DIR}"
                    ${PARSER_SPLIT_PY_ARG}
                    ${PARSER_MAX_PER_TU_PY_ARG}
                    ${PARSER_REGISTRY_HEADER_PY_ARG}
                    ${PARSER_REGISTRY_INSTANCE_PY_ARG})
            else()
                set(PARSER_COMMAND
                    ${CMAKE_COMMAND}
                    "-DHEADER=${ABS_HDR}" "-DOUT_DIR=${GEN_DIR}"
                    ${PARSER_SPLIT_ARG}
                    ${PARSER_MAX_PER_TU_ARG}
                    ${PARSER_REGISTRY_HEADER_ARG}
                    ${PARSER_REGISTRY_INSTANCE_ARG}
                    -P "${GR_BLOCKLIB_CMAKE_GENERATOR}")
            endif()

            # run the generator immediately at configuration time.
            message(STATUS "[BlockLibMacros] Running: ${PARSER_COMMAND}")
            execute_process(
                    COMMAND ${PARSER_COMMAND}
                    RESULT_VARIABLE gen_res
                    OUTPUT_VARIABLE gen_out
                    ERROR_VARIABLE gen_err
                    OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_STRIP_TRAILING_WHITESPACE
            )
            message(STATUS "[BlockLibMacros] Output from the generator for ${ABS_HDR}:\n${gen_out}")
            if(NOT gen_res EQUAL 0)
                message(FATAL_ERROR "Error running the block-registration generator on ${HDR}: ${gen_err}")
            endif()
        endif()

        # Glob for the generated .cpp files.
        file(GLOB GENERATED_FILES "${GEN_DIR}/${BASENAME}*.cpp")
        # message(STATUS "[BlockLibMacros] Globed for generated files in ${GEN_DIR} named ${BASENAME}*.cpp got:\n${GENERATED_FILES}")
        if(NOT GENERATED_FILES)
            # If no .cpp files were generated, create a dummy file.
            set(DUMMY_CPP "${GEN_DIR}/dummy_${BASENAME}.cpp")
            file(WRITE "${DUMMY_CPP}" "// No macros or expansions found for '${BASENAME}'\n")
            # do not prepend the precompiled header to this trivial TU
            set_source_files_properties("${DUMMY_CPP}" PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
            list(APPEND GENERATED_FILES "${DUMMY_CPP}")
        endif()

        list(APPEND GEN_CPP_LIST ${GENERATED_FILES})

    endforeach()

        # Merge generated declarations.hpp.in into single declarations.hpp
        # and raw_calls.hpp.in into a single raw_calls.hpp
        message(STATUS "[BlockLibMacros] generating ${GEN_DIR}/declarations.hpp from ${GEN_DIR}/*_declarations.hpp.in")
        file(GLOB DECLARATIONS_FILES "${GEN_DIR}/*_declarations.hpp.in")
        if(DECLARATIONS_FILES)
            gr_detail_merge_files_into(${GEN_DIR}/declarations.hpp "${DECLARATIONS_FILES}")
        endif()

        message(STATUS "[BlockLibMacros] generating ${GEN_DIR}/raw_calls.hpp from ${GEN_DIR}/*_raw_calls.hpp.in")
        file(GLOB RAW_CALLS_FILES "${GEN_DIR}/*_raw_calls.hpp.in")
        if(RAW_CALLS_FILES)
            gr_detail_merge_files_into(${GEN_DIR}/raw_calls.hpp "${RAW_CALLS_FILES}")
        endif()

        set(GENERATED_PUBLIC_HEADER_SOURCE "${GEN_DIR}/${MODULE_NAME_BASE}.hpp")
        if(EXISTS "${GENERATED_PUBLIC_HEADER_SOURCE}")
            set(GENERATED_PUBLIC_HEADER_BUILD_DIR "${CMAKE_BINARY_DIR}/include/gnuradio-4.0")
            set(GENERATED_PUBLIC_HEADER_BUILD_PATH "${GENERATED_PUBLIC_HEADER_BUILD_DIR}/${MODULE_NAME_BASE}.hpp")
            file(MAKE_DIRECTORY "${GENERATED_PUBLIC_HEADER_BUILD_DIR}")
            configure_file("${GENERATED_PUBLIC_HEADER_SOURCE}" "${GENERATED_PUBLIC_HEADER_BUILD_PATH}" COPYONLY)
        endif()

    target_sources(${LIB_NAME} PRIVATE ${GEN_CPP_LIST})
endfunction()

function(gr_add_block_library LIB_NAME)
    if(DEFINED GR_ENABLE_BLOCK_REGISTRY AND NOT ${GR_ENABLE_BLOCK_REGISTRY})
        message(WARNING "GR_ENABLE_BLOCK_REGISTRY is set to Off, not generating libraries for ${LIB_NAME}")
        return()
    endif()

    set(options "SPLIT_BLOCK_INSTANTIATIONS" "MAKE_SHARED_LIBRARY" "MAKE_STATIC_LIBRARY")
    set(oneValueArgs REGISTRY_HEADER REGISTRY_INSTANCE MAX_REGISTRATIONS_PER_TU)
    set(multiValueArgs HEADERS SOURCES LINK_LIBRARIES)
    cmake_parse_arguments(CBL "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(CBL_SPLIT_BLOCK_INSTANTIATIONS)
      set(SPLIT_BLOCK_INSTANTIATIONS_ARG "SPLIT_BLOCK_INSTANTIATIONS")
    else()
      set(SPLIT_BLOCK_INSTANTIATIONS_ARG "")
    endif()

    if(DEFINED CBL_MAX_REGISTRATIONS_PER_TU AND NOT CBL_MAX_REGISTRATIONS_PER_TU STREQUAL "")
      set(MAX_REGISTRATIONS_PER_TU_ARG MAX_REGISTRATIONS_PER_TU ${CBL_MAX_REGISTRATIONS_PER_TU})
    else()
      set(MAX_REGISTRATIONS_PER_TU_ARG "")
    endif()

    set(OBJECT_LIB_NAME "${LIB_NAME}Object")
    add_library(${OBJECT_LIB_NAME} OBJECT ${CBL_SOURCES})
    set_target_properties(${OBJECT_LIB_NAME} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    gr_generate_block_instantiations(${OBJECT_LIB_NAME}
        HEADERS ${CBL_HEADERS}
        MODULE_NAME_BASE ${LIB_NAME}
        ${SPLIT_BLOCK_INSTANTIATIONS_ARG}
        ${MAX_REGISTRATIONS_PER_TU_ARG})

    target_link_libraries(${OBJECT_LIB_NAME} PUBLIC gnuradio4::gnuradio-core gnuradio4::gnuradio-blocklib-core ${CBL_LINK_LIBRARIES})
    # warning flags are build-local to the project that sets them, so pick up the consuming
    # project's own warning target; object libs stay build-local, so the private link is safe
    if(TARGET gnuradio-options)
        target_link_libraries(${OBJECT_LIB_NAME} PRIVATE gnuradio-options)
    endif()

    if(GR_BLOCKLIB_PCH)
        set(PCH_HEADERS "<gnuradio-4.0/BlockRegistry.hpp>")
        foreach(HDR IN LISTS CBL_HEADERS)
            get_filename_component(ABS_HDR "${HDR}" ABSOLUTE)
            list(APPEND PCH_HEADERS "${ABS_HDR}")
        endforeach()
        target_precompile_headers(${OBJECT_LIB_NAME} PRIVATE ${PCH_HEADERS})
        if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
            target_compile_options(${OBJECT_LIB_NAME} PRIVATE -fpch-instantiate-templates)
        endif()
    endif()

    if(CBL_MAKE_SHARED_LIBRARY)
        set(SHARED_LIB_NAME "${LIB_NAME}Shared")
        message(STATUS "[BlockLibMacros] Creating a shared library target ${SHARED_LIB_NAME}")
        add_library(${SHARED_LIB_NAME} SHARED)
        if(NOT TARGET gnuradio4::${SHARED_LIB_NAME})
            add_library(gnuradio4::${SHARED_LIB_NAME} ALIAS ${SHARED_LIB_NAME})
        endif()
        target_include_directories(${SHARED_LIB_NAME} PUBLIC $<BUILD_INTERFACE:${CMAKE_BINARY_DIR}/include>
                                                          $<INSTALL_INTERFACE:include>)
        target_sources(${SHARED_LIB_NAME} PRIVATE $<TARGET_OBJECTS:${OBJECT_LIB_NAME}>)
        target_link_libraries(${SHARED_LIB_NAME} PUBLIC gnuradio4::gnuradio-core gnuradio4::gnuradio-blocklib-core ${CBL_LINK_LIBRARIES})
        install(
            TARGETS ${SHARED_LIB_NAME}
            EXPORT gnuradio4Targets
            LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins)
    endif()

    if(CBL_MAKE_STATIC_LIBRARY)
        set(STATIC_LIB_NAME "${LIB_NAME}Static")
        message(STATUS "[BlockLibMacros] Creating a static library target ${STATIC_LIB_NAME}")
        add_library(${STATIC_LIB_NAME} STATIC)
        if(NOT TARGET gnuradio4::${STATIC_LIB_NAME})
            add_library(gnuradio4::${STATIC_LIB_NAME} ALIAS ${STATIC_LIB_NAME})
        endif()
        target_include_directories(${STATIC_LIB_NAME} PUBLIC $<BUILD_INTERFACE:${CMAKE_BINARY_DIR}/include>
                                  $<INSTALL_INTERFACE:include>)
        target_sources(${STATIC_LIB_NAME} PRIVATE $<TARGET_OBJECTS:${OBJECT_LIB_NAME}>)
        target_link_libraries(${STATIC_LIB_NAME} PUBLIC gnuradio4::gnuradio-core gnuradio4::gnuradio-blocklib-core ${CBL_LINK_LIBRARIES})
        install(
            TARGETS ${STATIC_LIB_NAME}
            EXPORT gnuradio4Targets
            ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}/gnuradio-4/plugins)
    endif()

    install(FILES "${CMAKE_BINARY_DIR}/include/gnuradio-4.0/${LIB_NAME}.hpp"
        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/gnuradio-4.0")

    # TODO Install pkgconfig files, CMake files for finding the package,
    # header for blocklib init
endfunction()

function(gr_add_block_plugin LIB_NAME)
    if(DEFINED GR_ENABLE_BLOCK_REGISTRY AND NOT ${GR_ENABLE_BLOCK_REGISTRY})
        message(WARNING "GR_ENABLE_BLOCK_REGISTRY is set to Off, not generating plugin ${LIB_NAME}")
        return()
    endif()

    if(DEFINED INTERNAL_ENABLE_BLOCK_PLUGINS AND NOT ${INTERNAL_ENABLE_BLOCK_PLUGINS})
        message(WARNING "INTERNAL_ENABLE_BLOCK_PLUGINS is set to Off, not generating plugin ${LIB_NAME}")
        return()
    endif()

    set(options "SPLIT_BLOCK_INSTANTIATIONS" "NO_INSTALL")
    set(oneValueArgs MAX_REGISTRATIONS_PER_TU)
    set(multiValueArgs HEADERS SOURCES LINK_LIBRARIES)
    cmake_parse_arguments(CBL "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

    if(CBL_SPLIT_BLOCK_INSTANTIATIONS)
      set(SPLIT_BLOCK_INSTANTIATIONS_ARG "SPLIT_BLOCK_INSTANTIATIONS")
    else()
      set(SPLIT_BLOCK_INSTANTIATIONS_ARG "")
    endif()

    if(DEFINED CBL_MAX_REGISTRATIONS_PER_TU AND NOT CBL_MAX_REGISTRATIONS_PER_TU STREQUAL "")
      set(MAX_REGISTRATIONS_PER_TU_ARG MAX_REGISTRATIONS_PER_TU ${CBL_MAX_REGISTRATIONS_PER_TU})
    else()
      set(MAX_REGISTRATIONS_PER_TU_ARG "")
    endif()

    set(OBJECT_LIB_NAME "${LIB_NAME}")
    add_library(${OBJECT_LIB_NAME} OBJECT
        ${CBL_SOURCES}
    )
    set_target_properties(${OBJECT_LIB_NAME} PROPERTIES POSITION_INDEPENDENT_CODE ON)
    gr_generate_block_instantiations(${OBJECT_LIB_NAME}
        HEADERS ${CBL_HEADERS}
        SOURCES ${CBL_SOURCES}
        LINK_LIBRARIES ${CBL_LINK_LIBRARIES}
        MODULE_NAME_BASE ${LIB_NAME}
        ${SPLIT_BLOCK_INSTANTIATIONS_ARG}
        ${MAX_REGISTRATIONS_PER_TU_ARG}
        REGISTRY_HEADER
        gnuradio-4.0/Plugin.hpp
        REGISTRY_INSTANCE
        grPluginInstance)
    target_link_libraries(${OBJECT_LIB_NAME} PUBLIC gnuradio4::gnuradio-core gnuradio4::gnuradio-blocklib-core gnuradio4::gnuradio-plugin ${CBL_LINK_LIBRARIES})
    if(TARGET gnuradio-options)
        target_link_libraries(${OBJECT_LIB_NAME} PRIVATE gnuradio-options)
    endif()

    if(GR_BLOCKLIB_PCH)
        set(PCH_HEADERS "<gnuradio-4.0/Plugin.hpp>")
        foreach(HDR IN LISTS CBL_HEADERS)
            get_filename_component(ABS_HDR "${HDR}" ABSOLUTE)
            list(APPEND PCH_HEADERS "${ABS_HDR}")
        endforeach()
        target_precompile_headers(${OBJECT_LIB_NAME} PRIVATE ${PCH_HEADERS})
        if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
            target_compile_options(${OBJECT_LIB_NAME} PRIVATE -fpch-instantiate-templates)
        endif()
    endif()

    set(PLUGIN_LIB_NAME "${LIB_NAME}Plugin")
    message(STATUS "[BlockLibMacros] Creating a plugin target ${PLUGIN_LIB_NAME}")
    add_library(${PLUGIN_LIB_NAME} SHARED)
    target_link_libraries(${PLUGIN_LIB_NAME} ${OBJECT_LIB_NAME})
    if(NOT CBL_NO_INSTALL)
        install(TARGETS ${PLUGIN_LIB_NAME} LIBRARY DESTINATION lib)
    endif()

    # TODO Install pkgconfig files, CMake files for finding the package,
    # header for blocklib init

endfunction()
